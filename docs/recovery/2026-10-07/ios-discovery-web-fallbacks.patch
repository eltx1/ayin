+
+private func emptyHome() -> DiscoveryHomeResponse {
+    DiscoveryHomeResponse(rows: ["EMPTY", "UNAVAILABLE"].map { availability in
+        DiscoveryRow(
+            key: availability, title: availability, items: [],
+            availability: availability, nextCursor: nil
+        )
+    })
