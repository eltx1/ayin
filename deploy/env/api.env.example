# Copy to /home/ayin/env/api.env and chmod 600. Never commit real values.
# Keep comments on their own lines. Values are parsed literally; quote only when needed.
NODE_ENV=production
APP_ENV=production
API_HOST=127.0.0.1
PORT=4000

# Canonical public origins. Keep these identical while browser sessions use cookies.
CORS_ORIGIN=https://ayin.stream
WEB_ORIGIN=https://ayin.stream

# Zero-budget V1 production topology: PostgreSQL runs locally on the AYIN EC2 host and is
# reachable only through loopback. R2 remains the only external storage service required by AYIN.
# Use a dedicated least-privilege database role and a random password generated on the server.
DATABASE_URL=postgresql://ayin_app:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/ayin?schema=public

# Authentication and privacy secrets. Generate unique values on the server.
# AUTH_TOKEN_SECRET and ANALYTICS_HASH_SALT: at least 32 random characters.
# PAYOUT_DATA_ENCRYPTION_KEY: exactly 32 random bytes encoded as base64.
AUTH_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_SESSION_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
PAYOUT_DATA_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
ANALYTICS_HASH_SALT=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Cloudflare R2. Production deliberately refuses to fall back to development storage.
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_BUCKET=REPLACE_WITH_R2_BUCKET
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_REGION=auto
R2_UPLOAD_URL_TTL_SECONDS=900
R2_PART_SIZE_BYTES=16777216
R2_MULTIPART_THRESHOLD_BYTES=67108864
UPLOAD_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Bound media-processing subprocesses and R2 worker operations so one pathological source or
# network stall cannot hold a worker forever. Omit an optional key to use its default.
# FFprobe: 10-600 seconds. FFmpeg: 60-86400 seconds.
# R2 metadata HEAD/DELETE: 10-600 seconds. R2 GET/PUT transfer: 300-86400 seconds.
MEDIA_PROCESSING_FFPROBE_TIMEOUT_SECONDS=120
MEDIA_PROCESSING_FFMPEG_TIMEOUT_SECONDS=21600
MEDIA_PROCESSING_R2_METADATA_TIMEOUT_SECONDS=60
MEDIA_PROCESSING_R2_TRANSFER_TIMEOUT_SECONDS=21600

# Creator TV FAST / linear owned compute. Keep this disabled until Task 75 acceptance has
# been exercised on the production host and schedule drift/monitoring are stable.
# LINEAR_PUBLIC_BASE_URL must route to the API's /public/linear endpoint.
LINEAR_COMPUTE_ENABLED=0
LINEAR_PUBLIC_BASE_URL=https://api.ayin.stream/public/linear
LINEAR_OUTPUT_ROOT=/home/ayin/runtime/linear
LINEAR_SEGMENT_DURATION_SECONDS=4
LINEAR_RECONCILE_INTERVAL_SECONDS=30
LINEAR_MAX_RECOVERY_ATTEMPTS=3

# Task 76 linear SSAI / Google Ad Manager DAI. Default off.
# LINEAR_SSAI_BREAK_DURATION_SECONDS is intentionally blank until a real monetization policy is set.
# GAM_DAI_ASSET_KEY must be copied from a real Google Ad Manager DAI live stream; never guess it.
LINEAR_SSAI_ENABLED=0
LINEAR_SSAI_KILL_SWITCH=0
LINEAR_SSAI_BREAK_DURATION_SECONDS=
GAM_DAI_ENABLED=0
GAM_DAI_ASSET_KEY=

# Mux live provider. Keep creation disabled until Task 73 real-provider acceptance passes.
# The three control-plane credentials must be configured together so AYIN can still
# synchronize/stop existing Mux resources and verify webhooks while the creation kill switch is off.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SIGNING_SECRET=
MUX_LIVE_PRODUCTION_ENABLED=0

# Google Ad Manager. Keep production disabled until real account values are available.
# Never use guessed IDs. When enabling production, set GAM_TEST_MODE=0 and populate all
# required network/ad-unit identifiers first.
GAM_NETWORK_CODE=
GAM_PUBLISHER_ID=
GAM_VIDEO_AD_UNIT_PATH=
GAM_DISPLAY_AD_UNIT_PREFIX=
GAM_ADS_TXT_RELATIONSHIP=
GAM_TEST_MODE=1
GAM_PRODUCTION_ENABLED=0