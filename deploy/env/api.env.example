# Copy to /home/ayin/env/api.env and chmod 600. Never commit real values.
NODE_ENV=production
API_HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=https://ayin.stream
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ayin?schema=public

# Add the production auth/session, R2/media, analytics and mail variables required
# by enabled AYIN modules. Keep every secret outside git.

# Google Ad Manager. Leave blank/disabled until real values are obtained from the
# production account. Never replace these comments with guessed identifiers.
GAM_NETWORK_CODE=
GAM_PUBLISHER_ID=
GAM_VIDEO_AD_UNIT_PATH=
GAM_DISPLAY_AD_UNIT_PREFIX=
GAM_ADS_TXT_RELATIONSHIP=
GAM_TEST_MODE=1
GAM_PRODUCTION_ENABLED=0
