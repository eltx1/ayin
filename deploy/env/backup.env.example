# AYIN PostgreSQL backup storage. Copy to /home/ayin/env/backup.env with mode 600.
# Use credentials restricted to the private database-backup bucket only.
R2_BACKUP_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BACKUP_BUCKET=ayin-production-db-backups
R2_BACKUP_ACCESS_KEY_ID=replace-with-dedicated-backup-access-key
R2_BACKUP_SECRET_ACCESS_KEY=replace-with-dedicated-backup-secret-key

# Public age recipient only. The matching private identity MUST be stored off the production EC2 host.
BACKUP_AGE_RECIPIENT=age1replacewithrealrecipient
BACKUP_RETENTION_DAYS=35
