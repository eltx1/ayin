// Creator finance records added by 20260831032000_creator_finance_center.
// Provider/status fields intentionally remain strings because the migration uses
// VARCHAR + CHECK constraints so future provider adapters can be introduced
// without a PostgreSQL enum migration.

enum RevenueReportImportFormat {
  STRUCTURED
  CSV
}

enum RevenueReconciliationStatus {
  MATCHED
  UNMATCHED
  DUPLICATE
  CORRECTED
  FINALIZED
  ANOMALOUS
}

enum PayoutProviderTransferState {
  READY
  SUBMITTING
  SUBMISSION_UNKNOWN
  SUBMITTED
  PROCESSING
  CANCEL_REQUESTED
  COMPLETED
  FAILED
  CANCELLED
  UNKNOWN
}

model CreatorPayoutProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  channelId            String   @unique @db.Uuid
  legalName            String   @db.VarChar(160)
  preferredCurrency    String   @db.Char(3)
  provider             String   @default("MANUAL") @db.VarChar(64)
  destinationEncrypted                String?   @db.Text
  destinationMask                     String?   @db.VarChar(120)
  providerDestinationTokenEncrypted   String?   @db.Text
  providerDestinationVerifiedAt       DateTime?
  countryCode                         String?   @db.Char(2)
  identityStatus       String   @default("NOT_STARTED") @db.VarChar(24)
  taxStatus            String   @default("NOT_PROVIDED") @db.VarChar(24)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  channel Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@index([provider, updatedAt])
}

model RevenueDispute {
  id                  String    @id @default(uuid()) @db.Uuid
  channelId           String    @db.Uuid
  payoutId            String?   @db.Uuid
  createdByAccountId  String    @db.Uuid
  category            String    @db.VarChar(24)
  message             String    @db.Text
  status              String    @default("OPEN") @db.VarChar(24)
  resolution          String?   @db.Text
  resolvedByAccountId String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  resolvedAt          DateTime?

  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  payout     Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdBy  Account  @relation("RevenueDisputeCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  resolvedBy Account? @relation("RevenueDisputeResolver", fields: [resolvedByAccountId], references: [id], onDelete: SetNull)

  @@index([channelId, status, createdAt])
  @@index([status, createdAt])
  @@index([payoutId])
}

model RevenueSourceReport {
  id                  String                    @id @default(uuid()) @db.Uuid
  source              String                    @db.VarChar(80)
  sourceReportId      String                    @db.VarChar(160)
  periodStart         DateTime
  periodEnd           DateTime
  currency            String                    @db.Char(3)
  state               EarningsEntryState
  importFormat        RevenueReportImportFormat
  importedByAccountId String?                   @db.Uuid
  totalRows           Int                       @default(0)
  matchedRows         Int                       @default(0)
  unmatchedRows       Int                       @default(0)
  duplicateRows       Int                       @default(0)
  correctedRows       Int                       @default(0)
  finalizedRows       Int                       @default(0)
  anomalousRows       Int                       @default(0)
  createdAt           DateTime                  @default(now())

  rows RevenueSourceReportRow[]

  @@unique([source, sourceReportId])
  @@index([source, createdAt])
  @@index([periodStart, periodEnd])
  @@index([createdAt])
}

model RevenueSourceReportRow {
  id                   String                      @id @default(uuid()) @db.Uuid
  reportId             String                      @db.Uuid
  rowNumber            Int
  source               String                      @db.VarChar(80)
  externalRowId        String                      @db.VarChar(160)
  channelRef           String?                     @db.VarChar(160)
  videoRef             String?                     @db.VarChar(200)
  contentRef           String?                     @db.VarChar(200)
  channelId            String?                     @db.Uuid
  videoId              String?                     @db.Uuid
  grossAmount          Decimal                     @db.Decimal(20, 6)
  creatorAmount        Decimal?                    @db.Decimal(20, 6)
  currency             String                      @db.Char(3)
  state                EarningsEntryState
  reconciliationStatus RevenueReconciliationStatus
  ledgerEntryId        String?                     @db.Uuid
  priorRowId           String?                     @db.Uuid
  reason               String?                     @db.VarChar(500)
  memo                 String?                     @db.VarChar(500)
  createdAt            DateTime                    @default(now())

  report RevenueSourceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, rowNumber])
  @@index([source, externalRowId, createdAt])
  @@index([reportId, reconciliationStatus])
  @@index([channelId, createdAt])
  @@index([videoId, createdAt])
  @@index([ledgerEntryId])
}


model PayoutProviderTransfer {
  id                       String                      @id @default(uuid()) @db.Uuid
  payoutId                 String                      @unique @db.Uuid
  provider                 String                      @db.VarChar(64)
  idempotencyKey           String                      @unique @db.VarChar(200)
  state                    PayoutProviderTransferState @default(READY)
  externalTransferId       String?                     @db.VarChar(255)
  providerResponseState    String?                     @db.VarChar(120)
  submitAttempts           Int                         @default(0)
  statusAttempts           Int                         @default(0)
  cancelAttempts           Int                         @default(0)
  nextRetryAt              DateTime?
  lastErrorCode            String?                     @db.VarChar(160)
  lastErrorMessage         String?                     @db.VarChar(1000)
  submittedAt              DateTime?
  lastCheckedAt            DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  payout Payout                @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  events PayoutProviderEvent[]

  @@unique([provider, externalTransferId])
  @@index([state, nextRetryAt])
  @@index([provider, state, updatedAt])
}

model PayoutProviderEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  transferId         String?  @db.Uuid
  provider           String   @db.VarChar(64)
  externalEventId    String   @db.VarChar(255)
  eventType          String   @db.VarChar(120)
  providerState      String?  @db.VarChar(120)
  verified           Boolean  @default(false)
  payloadSha256      String   @db.Char(64)
  receivedAt         DateTime @default(now())
  processedAt        DateTime?

  transfer PayoutProviderTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([transferId, receivedAt])
}
