model AnalyticsEvent {
  id              String   @id @default(uuid()) @db.Uuid
  clientEventId   String   @unique @db.VarChar(120)
  schemaVersion   Int      @default(1)
  eventName       String   @db.VarChar(64)
  occurredAt      DateTime
  receivedAt      DateTime @default(now())
  sessionHash     String   @db.Char(64)
  profileHash     String?  @db.Char(64)
  accountId       String?  @db.Uuid
  channelId       String?  @db.Uuid
  videoId         String?  @db.Uuid
  source          String   @default("WEB") @db.VarChar(32)
  deviceClass     String?  @db.VarChar(24)
  durationDeltaMs Int?
  positionMs      Int?
  metadata        Json?

  @@index([occurredAt])
  @@index([eventName, occurredAt])
  @@index([sessionHash, occurredAt])
  @@index([channelId, occurredAt])
  @@index([videoId, occurredAt])
  @@index([accountId, occurredAt])
}

model TrendingScoreSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  scopeKey      String   @db.VarChar(16)
  regionCode    String?  @db.VarChar(2)
  videoId       String   @db.Uuid
  score         Float
  audienceCount Int
  components    Json
  sampledAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scopeKey, videoId])
  @@index([scopeKey, score])
  @@index([sampledAt])
}

model RecommendationExposure {
  id          String   @id @default(uuid()) @db.Uuid
  versionId   String   @db.VarChar(120)
  algorithmId String   @db.VarChar(120)
  surface     String   @db.VarChar(32)
  mode        String   @db.VarChar(32)
  rankingSize Int
  itemIds     Json
  components  Json
  createdAt   DateTime @default(now())

  @@index([versionId, createdAt])
  @@index([surface, createdAt])
  @@index([createdAt])
}
