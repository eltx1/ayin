model AnalyticsEvent {
  id              String   @id @default(uuid()) @db.Uuid
  clientEventId   String   @unique @db.VarChar(120)
  schemaVersion   Int      @default(1)
  eventName       String   @db.VarChar(64)
  occurredAt      DateTime
  receivedAt      DateTime @default(now())
  sessionHash     String   @db.Char(64)
  profileHash     String?  @db.Char(64)
  accountId       String?  @db.Uuid
  channelId       String?  @db.Uuid
  videoId         String?  @db.Uuid
  source          String   @default("WEB") @db.VarChar(32)
  deviceClass     String?  @db.VarChar(24)
  durationDeltaMs Int?
  positionMs      Int?
  metadata        Json?

  @@index([occurredAt])
  @@index([receivedAt])
  @@index([eventName, occurredAt])
  @@index([sessionHash, occurredAt])
  @@index([channelId, occurredAt])
  @@index([videoId, occurredAt])
  @@index([accountId, occurredAt])
}

model TrendingScoreSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  scopeKey      String   @db.VarChar(16)
  regionCode    String?  @db.VarChar(2)
  videoId       String   @db.Uuid
  score         Float
  audienceCount Int
  components    Json
  sampledAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scopeKey, videoId])
  @@index([scopeKey, score])
  @@index([sampledAt])
}

model RecommendationExposure {
  id          String   @id @default(uuid()) @db.Uuid
  versionId   String   @db.VarChar(120)
  algorithmId String   @db.VarChar(120)
  surface     String   @db.VarChar(32)
  mode        String   @db.VarChar(32)
  rankingSize Int
  itemIds     Json
  components  Json
  createdAt   DateTime @default(now())

  @@index([versionId, createdAt])
  @@index([surface, createdAt])
  @@index([createdAt])
}

model AnalyticsVideoHourlyRollup {
  bucketStart         DateTime
  channelId           String   @db.Uuid
  videoId             String   @db.Uuid
  views               Int      @default(0)
  starts              Int      @default(0)
  watchTimeMs         BigInt   @default(0)
  completions         Int      @default(0)
  startupSamples      Int      @default(0)
  startupDurationMs   BigInt   @default(0)
  bufferEvents        Int      @default(0)
  bufferSamples       Int      @default(0)
  bufferDurationMs    BigInt   @default(0)
  hlsFatalEvents      Int      @default(0)
  mp4FallbackEvents   Int      @default(0)
  qualitySwitchEvents Int      @default(0)
  adRequests          Int      @default(0)
  adStarts            Int      @default(0)
  adCompletes         Int      @default(0)
  adClicks            Int      @default(0)
  adErrors            Int      @default(0)

  @@id([bucketStart, videoId])
  @@index([channelId, bucketStart])
}

model AnalyticsVideoDailyRollup {
  bucketStart         DateTime
  channelId           String   @db.Uuid
  videoId             String   @db.Uuid
  views               Int      @default(0)
  starts              Int      @default(0)
  watchTimeMs         BigInt   @default(0)
  completions         Int      @default(0)
  startupSamples      Int      @default(0)
  startupDurationMs   BigInt   @default(0)
  bufferEvents        Int      @default(0)
  bufferSamples       Int      @default(0)
  bufferDurationMs    BigInt   @default(0)
  hlsFatalEvents      Int      @default(0)
  mp4FallbackEvents   Int      @default(0)
  qualitySwitchEvents Int      @default(0)
  adRequests          Int      @default(0)
  adStarts            Int      @default(0)
  adCompletes         Int      @default(0)
  adClicks            Int      @default(0)
  adErrors            Int      @default(0)

  @@id([bucketStart, videoId])
  @@index([channelId, bucketStart])
}

model AnalyticsChannelDailyRollup {
  bucketStart         DateTime
  channelId           String   @db.Uuid
  views               Int      @default(0)
  starts              Int      @default(0)
  watchTimeMs         BigInt   @default(0)
  completions         Int      @default(0)
  subscribeEvents     Int      @default(0)
  likeEvents          Int      @default(0)
  startupSamples      Int      @default(0)
  startupDurationMs   BigInt   @default(0)
  bufferEvents        Int      @default(0)
  bufferSamples       Int      @default(0)
  bufferDurationMs    BigInt   @default(0)
  hlsFatalEvents      Int      @default(0)
  mp4FallbackEvents   Int      @default(0)
  qualitySwitchEvents Int      @default(0)
  analyticsAdEvents   Int      @default(0)
  analyticsAdErrors   Int      @default(0)
  adRequests          Int      @default(0)
  adFills             Int      @default(0)

  @@id([bucketStart, channelId])
  @@index([channelId, bucketStart])
}

model AnalyticsChannelDailyDimensionRollup {
  bucketStart DateTime
  channelId   String   @db.Uuid
  dimension   String   @db.VarChar(32)
  value       String   @db.VarChar(64)
  count       Int      @default(0)

  @@id([bucketStart, channelId, dimension, value])
  @@index([channelId, bucketStart, dimension], map: "analytics_channel_dimension_bucket_idx")
}

model AnalyticsPlaybackSessionDailyRollup {
  bucketStart   DateTime
  channelId     String   @db.Uuid
  videoId       String   @db.Uuid
  sessionHash   String   @db.Char(64)
  started       Boolean  @default(false)
  maxPositionMs Int?

  @@id([bucketStart, channelId, videoId, sessionHash])
  @@index([channelId, bucketStart])
  @@index([videoId, bucketStart])
}

model AnalyticsPlatformSessionDailyRollup {
  bucketStart DateTime
  sessionHash String   @db.Char(64)

  @@id([bucketStart, sessionHash])
  @@index([bucketStart])
}

model AnalyticsPlatformDailyRollup {
  bucketStart    DateTime @id
  uniqueSessions Int      @default(0)
  views          Int      @default(0)
  starts         Int      @default(0)
  watchTimeMs    BigInt   @default(0)
  completions    Int      @default(0)
  uploads        Int      @default(0)
  tvStarts       Int      @default(0)
  adEvents       Int      @default(0)
  errors         Int      @default(0)
  bufferEvents   Int      @default(0)
}

model AnalyticsRollupState {
  key              String   @id @db.VarChar(32)
  lastSuccessfulAt DateTime?
  lastCleanupAt    DateTime?
  updatedAt        DateTime @updatedAt
}

