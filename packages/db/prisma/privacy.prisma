enum AccountDeletionState {
  REQUESTED
  GRACE_PERIOD
  DEACTIVATED
  ANONYMIZED
  CANCELLED
}

enum PrivacyMediaDeletionKind {
  OBJECT
  PREFIX
  MULTIPART
  ALLOCATION
  OUTPUT_SETTLEMENT
}

enum PrivacyMediaDeletionScope {
  PRIVACY
  UPLOAD_SESSION
  PROCESSING_SOURCE
  PROCESSING_OUTPUT
}

enum PrivacyMediaDeletionStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model AccountDeletionRequest {
  id                      String               @id @default(uuid()) @db.Uuid
  accountId               String               @db.Uuid
  state                   AccountDeletionState @default(REQUESTED)
  requestedFromSessionId  String?              @db.Uuid
  requestedAt             DateTime             @default(now())
  graceEndsAt             DateTime?
  deactivatedAt           DateTime?
  anonymizedAt            DateTime?
  cancelledAt             DateTime?
  mediaCleanupQueuedAt    DateTime?
  mediaCleanupCompletedAt DateTime?
  lastError               String?              @db.Text
  lifecycleLeaseOwner     String?              @db.VarChar(200)
  lifecycleLeaseUntil     DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  mediaDeletionJobs PrivacyMediaDeletionJob[]

  @@index([accountId, createdAt])
  @@index([state, graceEndsAt])
  @@index([state, deactivatedAt])
  @@index([lifecycleLeaseUntil])
}

model PrivacyMediaDeletionJob {
  id          String                     @id @default(uuid()) @db.Uuid
  requestId   String?                    @db.Uuid
  accountId   String?                    @db.Uuid
  kind        PrivacyMediaDeletionKind
  target      String?                    @db.VarChar(1024)
  operationKey String                    @unique @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(240)
  scope       PrivacyMediaDeletionScope  @default(PRIVACY)
  channelId String?                      @db.Uuid
  uploadSessionId String?                @db.Uuid
  sessionRevision Int?
  sourceAssetId String?                  @db.Uuid
  processingJobId String?                @db.Uuid
  outputAttemptId String?                @db.Uuid
  providerUploadId String?               @db.VarChar(1024)
  leaseToken String?                     @db.Uuid
  leaseExpiresAt DateTime?
  lastObservation String?                @db.VarChar(64)
  outputAddresses Json?
  settlementProofReference String?       @db.VarChar(200)
  settlementVerifiedAt DateTime?
  settlementLeaseToken String?           @db.Uuid
  // V1 evidence retains its original meaning; V2 records finite app settlement.
  cleanupContractVersion Int             @default(1)
  cleanupEvidence Json?
  observedAbsentAt DateTime?
  debtKind String?                      @db.VarChar(32)
  debtSince DateTime?
  recheckAt DateTime?
  recheckCount Int                       @default(0)
  retainUntil DateTime?
  status      PrivacyMediaDeletionStatus @default(PENDING)
  attempts    Int                        @default(0)
  availableAt DateTime                   @default(now())
  claimedAt   DateTime?
  completedAt DateTime?
  lastError   String?                    @db.Text
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  request AccountDeletionRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  // SQL partial unique index preserves legacy PRIVACY target deduplication.
  // Global operationKey also deduplicates standalone jobs with requestId=null.
  @@index([status, availableAt, createdAt])
  @@index([requestId, status])
  @@index([uploadSessionId, status])
  @@index([status, retainUntil])
  @@index([accountId, createdAt])
}
