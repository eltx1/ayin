enum CreatorTrustLevel {
  NEW
  STANDARD
  TRUSTED
  RESTRICTED
}

enum ModerationActionKind {
  WARN
  STRIKE
  SUSPEND_ACCOUNT
  SUSPEND_CHANNEL
  UNPUBLISH_VIDEO
  REMOVE_VIDEO
}

enum AppealStatus {
  OPEN
  REVIEWING
  UPHELD
  OVERTURNED
}

enum TakedownStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model CreatorTrustState {
  id             String            @id @default(uuid()) @db.Uuid
  channelId      String            @unique @db.Uuid
  level          CreatorTrustLevel @default(NEW)
  strikeCount    Int               @default(0)
  reviewRequired Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  @@index([level, reviewRequired])
}

model ModerationAction {
  id              String               @id @default(uuid()) @db.Uuid
  caseId          String?              @db.Uuid
  actorAccountId  String               @db.Uuid
  targetAccountId String?              @db.Uuid
  channelId       String?              @db.Uuid
  videoId         String?              @db.Uuid
  kind            ModerationActionKind
  reason          String               @db.Text
  createdAt       DateTime             @default(now())
  appeals         ModerationAppeal[]
  @@index([channelId, createdAt])
  @@index([targetAccountId, createdAt])
  @@index([videoId, createdAt])
}

model ModerationAppeal {
  id         String       @id @default(uuid()) @db.Uuid
  actionId   String       @db.Uuid
  accountId  String       @db.Uuid
  status     AppealStatus @default(OPEN)
  message    String       @db.Text
  resolution String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  action     ModerationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  @@index([accountId, status, createdAt])
  @@index([status, createdAt])
}

model TakedownRequest {
  id            String         @id @default(uuid()) @db.Uuid
  requesterId   String         @db.Uuid
  videoId       String?        @db.Uuid
  claimantName  String         @db.VarChar(160)
  contactEmail  String         @db.VarChar(320)
  rightsBasis   String         @db.VarChar(120)
  details       String         @db.Text
  status        TakedownStatus @default(OPEN)
  resolution    String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  @@index([status, createdAt])
  @@index([videoId, createdAt])
}
