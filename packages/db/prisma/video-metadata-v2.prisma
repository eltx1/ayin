enum VideoCategory {
  ENTERTAINMENT
  EDUCATION
  GAMING
  MUSIC
  NEWS
  SPORTS
  TECHNOLOGY
  LIFESTYLE
  FILM_ANIMATION
  OTHER
}

enum VideoMaturityLevel {
  GENERAL
  TEEN
  MATURE
}

enum VideoGeoAvailabilityMode {
  WORLDWIDE
  INCLUDE_ONLY
  EXCLUDE
}

enum VideoAdBreakPreference {
  AUTOMATIC
  DISABLED
  CUSTOM
}

// Optional creator-supplied metadata extension. No row is created for the
// zero-friction upload path unless a creator actually uses advanced metadata.
// contentType remains owned by Video and rights remain owned by
// ContentRightsDeclaration; this model intentionally does not duplicate them.
model VideoCreatorMetadata {
  videoId             String                   @id @db.Uuid
  tags                String[]                 @default([])
  category            VideoCategory?
  primaryLanguage     String?                  @db.VarChar(35)
  recordingDate       DateTime?                @db.Date
  seriesTitle         String?                  @db.VarChar(120)
  seasonNumber        Int?
  episodeNumber       Int?
  maturityLevel       VideoMaturityLevel?
  geoAvailabilityMode VideoGeoAvailabilityMode?
  geoCountries        String[]                 @default([])
  chapters            Json?                    @db.JsonB
  adBreakPreference   VideoAdBreakPreference?
  adBreakOffsetsSeconds Int[]                  @default([])
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  // The SQL migration enforces the FK to Video with ON DELETE CASCADE. Keeping
  // this extension unidirectional avoids changing the core Video relation graph.
  @@index([category])
  @@index([primaryLanguage])
}
