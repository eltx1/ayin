model AdminRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  role      String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@unique([accountId, role])
  @@index([accountId])
  @@index([role, createdAt])
}

enum MfaCredentialStatus {
  PENDING
  ENABLED
}

model AccountMfaCredential {
  accountId                String              @id @db.Uuid
  status                   MfaCredentialStatus @default(PENDING)
  encryptedSecret          String              @db.Text
  recoveryCodeHashes       String[]            @default([])
  version                  Int                 @default(1)
  pendingExpiresAt         DateTime
  enabledAt                DateTime?
  lastUsedCounter          BigInt?
  recoveryCodesGeneratedAt DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, enabledAt])
}
