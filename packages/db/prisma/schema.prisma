generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ChannelStatus {
  ACTIVE
  HIDDEN
  SUSPENDED
  REMOVED
}

enum ChannelMemberRole {
  OWNER
  ADMIN
  EDITOR
}

enum VideoStatus {
  DRAFT
  UPLOADING
  VALIDATING
  SCHEDULED
  PUBLISHED
  REMOVED
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum MediaAssetKind {
  SOURCE_VIDEO
  THUMBNAIL
  CAPTION
  CHANNEL_AVATAR
  CHANNEL_BANNER
  CREATIVE
}

enum MediaAssetStatus {
  PENDING
  UPLOADED
  VALIDATED
  REJECTED
  REMOVED
}

enum PlaylistSystemKey {
  UPLOADS
}

enum CreatorTvStatus {
  ACTIVE
  OFF_AIR
  DISABLED
}

enum TvScheduleSource {
  AUTO
  MANUAL
  ADMIN
}

enum TvScheduleStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SubscriptionNotificationLevel {
  NONE
  PERSONALIZED
  ALL
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum CommentStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum NotificationType {
  SYSTEM
  CHANNEL
  VIDEO
  COMMENT
  SUBSCRIPTION
  MODERATION
  MONETIZATION
}

enum RightsBasis {
  OWNED
  LICENSED
  AUTHORIZED
  PUBLIC_DOMAIN
  OTHER
}

enum RightsDeclarationStatus {
  CONFIRMED
  REVOKED
}

enum ReportReason {
  COPYRIGHT
  SPAM
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  MISLEADING
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationCaseStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
  CLOSED
}

enum PlatformSettingNamespace {
  CREATOR
  UPLOAD
  TV
  DISCOVERY
  ADVERTISING
  MONETIZATION
  MODERATION
  PLATFORM
}

enum PlatformSettingValueType {
  BOOLEAN
  INTEGER
  DECIMAL
  STRING
  JSON
}

enum AdInventoryFamily {
  IN_PLAYER_VIDEO
  OUTSIDE_PLAYER
}

enum AdPlacementFormat {
  PRE_ROLL
  MID_ROLL
  POST_ROLL
  DISPLAY
  NATIVE
}

enum AdvertiserStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CreativeType {
  VIDEO
  DISPLAY
  NATIVE
  VAST_TAG
}

enum CreativeStatus {
  DRAFT
  ACTIVE
  PAUSED
  REJECTED
  ARCHIVED
}

enum AdEventType {
  REQUEST
  FILL
  IMPRESSION
  START
  QUARTILE_25
  MIDPOINT
  QUARTILE_75
  COMPLETE
  CLICK
  ERROR
}

enum CreatorContractStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
}

enum EarningsEntryType {
  AD_REVENUE
  ADJUSTMENT
  REVERSAL
  PAYOUT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Account {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(320)
  passwordHash    String?       @db.VarChar(255)
  displayName     String        @db.VarChar(120)
  status          AccountStatus @default(ACTIVE)
  authVersion     Int           @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  closedAt        DateTime?

  viewerProfiles         ViewerProfile[]
  channelMemberships      ChannelMember[]
  rightsDeclarations      ContentRightsDeclaration[]
  notifications           Notification[]
  auditLogs               AdminAuditLog[]   @relation("AdminAuditActor")
  assignedModerationCases ModerationCase[] @relation("ModerationAssignee")

  @@index([status, createdAt])
}

model ViewerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @db.VarChar(120)
  isDefault Boolean  @default(false)
  isKids    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  watchProgress WatchProgress[]
  watchHistory  WatchHistory[]
  subscriptions Subscription[]
  reactions     Reaction[]
  comments      Comment[]
  reports       Report[]
  adEvents      AdEvent[]

  @@unique([accountId, slug])
  @@index([accountId, isDefault])
}

model Channel {
  id                 String        @id @default(uuid()) @db.Uuid
  handle             String        @unique @db.VarChar(80)
  name               String        @db.VarChar(120)
  description        String?       @db.Text
  status             ChannelStatus @default(ACTIVE)
  primaryTvChannelId String?       @unique @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  removedAt          DateTime?

  primaryTvChannel  CreatorTvChannel?  @relation("PrimaryCreatorTvChannel", fields: [primaryTvChannelId], references: [id], onDelete: SetNull)
  members           ChannelMember[]
  settings          ChannelSettings?
  videos            Video[]
  mediaAssets       MediaAsset[]
  playlists         Playlist[]
  creatorTvChannels CreatorTvChannel[] @relation("ChannelCreatorTvChannels")
  subscriptions     Subscription[]
  reports           Report[]
  creatorContracts  CreatorContract[]
  earningsEntries   EarningsLedgerEntry[]
  payouts           Payout[]

  @@index([status, createdAt])
}

model ChannelMember {
  id        String            @id @default(uuid()) @db.Uuid
  channelId String            @db.Uuid
  accountId String            @db.Uuid
  role      ChannelMemberRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([channelId, accountId])
  @@index([accountId, role])
  @@index([channelId, role])
}

model ChannelSettings {
  id                        String          @id @default(uuid()) @db.Uuid
  channelId                 String          @unique @db.Uuid
  defaultVideoVisibility    VideoVisibility @default(PUBLIC)
  defaultCommentsEnabled    Boolean         @default(true)
  autoAddPublishedToUploads Boolean         @default(true)
  autoAddPublishedToTv      Boolean         @default(true)
  tvAutoScheduleEnabled     Boolean         @default(true)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model Video {
  id                 String          @id @default(uuid()) @db.Uuid
  channelId          String          @db.Uuid
  slug               String          @unique @db.VarChar(160)
  title              String          @db.VarChar(200)
  description        String?         @db.Text
  status             VideoStatus     @default(DRAFT)
  visibility         VideoVisibility @default(PUBLIC)
  commentsEnabled    Boolean         @default(true)
  durationMs         Int?
  scheduledPublishAt DateTime?
  publishedAt        DateTime?
  removedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  channel            Channel                    @relation(fields: [channelId], references: [id], onDelete: Restrict)
  mediaAssets        MediaAsset[]
  playlistItems      PlaylistItem[]
  tvScheduleItems    TvScheduleItem[]
  watchProgress      WatchProgress[]
  watchHistory       WatchHistory[]
  reactions          Reaction[]
  comments           Comment[]
  rightsDeclarations ContentRightsDeclaration[]
  reports            Report[]
  adEvents           AdEvent[]
  earningsEntries    EarningsLedgerEntry[]

  @@index([channelId, status, publishedAt])
  @@index([status, visibility, publishedAt])
  @@index([scheduledPublishAt, status])
}

model MediaAsset {
  id          String           @id @default(uuid()) @db.Uuid
  videoId     String?          @db.Uuid
  channelId   String?          @db.Uuid
  kind        MediaAssetKind
  status      MediaAssetStatus @default(PENDING)
  r2ObjectKey String           @unique @db.VarChar(1024)
  mimeType    String           @db.VarChar(255)
  sizeBytes   BigInt
  width       Int?
  height      Int?
  durationMs  Int?
  checksum    String?          @db.VarChar(128)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  removedAt   DateTime?

  video     Video?     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  channel   Channel?   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creatives Creative[]

  @@index([videoId, kind, status])
  @@index([channelId, kind])
}

model Playlist {
  id          String             @id @default(uuid()) @db.Uuid
  channelId   String             @db.Uuid
  slug        String             @db.VarChar(160)
  name        String             @db.VarChar(160)
  description String?            @db.Text
  systemKey   PlaylistSystemKey?
  isProtected Boolean            @default(false)
  isPublic    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  channel        Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items          PlaylistItem[]
  creatorTvFeeds CreatorTvChannel[]

  @@unique([channelId, slug])
  @@unique([channelId, systemKey])
  @@index([channelId, createdAt])
}

model PlaylistItem {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @db.Uuid
  videoId    String   @db.Uuid
  position   Int
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@unique([playlistId, position])
  @@index([videoId])
}

model CreatorTvChannel {
  id               String          @id @default(uuid()) @db.Uuid
  channelId        String          @db.Uuid
  sourcePlaylistId String?         @db.Uuid
  slug             String          @unique @db.VarChar(160)
  name             String          @db.VarChar(160)
  status           CreatorTvStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  disabledAt       DateTime?

  channel           Channel             @relation("ChannelCreatorTvChannels", fields: [channelId], references: [id], onDelete: Cascade)
  sourcePlaylist    Playlist?            @relation(fields: [sourcePlaylistId], references: [id], onDelete: SetNull)
  primaryForChannel Channel?             @relation("PrimaryCreatorTvChannel")
  scheduleItems     TvScheduleItem[]

  @@index([channelId, status])
  @@index([sourcePlaylistId])
}

model TvScheduleItem {
  id          String           @id @default(uuid()) @db.Uuid
  tvChannelId String           @db.Uuid
  videoId     String           @db.Uuid
  source      TvScheduleSource @default(AUTO)
  status      TvScheduleStatus @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tvChannel CreatorTvChannel @relation(fields: [tvChannelId], references: [id], onDelete: Cascade)
  video     Video            @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@index([tvChannelId, startsAt])
  @@index([status, startsAt])
  @@index([videoId, startsAt])
}

model WatchProgress {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @db.Uuid
  videoId       String   @db.Uuid
  positionMs    Int      @default(0)
  lastWatchedAt DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile ViewerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  video   Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([profileId, videoId])
  @@index([profileId, lastWatchedAt])
  @@index([videoId, lastWatchedAt])
}

model WatchHistory {
  id             String   @id @default(uuid()) @db.Uuid
  profileId      String   @db.Uuid
  videoId        String   @db.Uuid
  firstWatchedAt DateTime @default(now())
  lastWatchedAt  DateTime @default(now())
  viewCount      Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile ViewerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  video   Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([profileId, videoId])
  @@index([profileId, lastWatchedAt])
}

model Subscription {
  id                String                        @id @default(uuid()) @db.Uuid
  profileId         String                        @db.Uuid
  channelId         String                        @db.Uuid
  notificationLevel SubscriptionNotificationLevel @default(PERSONALIZED)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  profile ViewerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  channel Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([profileId, channelId])
  @@index([channelId, createdAt])
  @@index([profileId, createdAt])
}

model Reaction {
  id        String       @id @default(uuid()) @db.Uuid
  profileId String       @db.Uuid
  videoId   String?      @db.Uuid
  commentId String?      @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  profile ViewerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  video   Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  comment Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([profileId, videoId])
  @@unique([profileId, commentId])
  @@index([videoId, type])
  @@index([commentId, type])
}

model Comment {
  id              String        @id @default(uuid()) @db.Uuid
  videoId         String        @db.Uuid
  authorProfileId String        @db.Uuid
  parentId        String?       @db.Uuid
  body            String        @db.Text
  status          CommentStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  removedAt       DateTime?

  video         Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  authorProfile ViewerProfile @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)
  parent        Comment?      @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies       Comment[]     @relation("CommentThread")
  reactions     Reaction[]
  reports       Report[]

  @@index([videoId, status, createdAt])
  @@index([parentId, createdAt])
  @@index([authorProfileId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  accountId String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?          @db.Text
  data      Json?            @db.JsonB
  readAt    DateTime?
  createdAt DateTime         @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, readAt, createdAt])
}

model ContentRightsDeclaration {
  id                  String                   @id @default(uuid()) @db.Uuid
  videoId             String                   @db.Uuid
  declaredByAccountId String                   @db.Uuid
  version             Int
  basis               RightsBasis
  status              RightsDeclarationStatus @default(CONFIRMED)
  statement           String?                  @db.Text
  declaredAt          DateTime                 @default(now())
  revokedAt           DateTime?

  video      Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  declaredBy Account @relation(fields: [declaredByAccountId], references: [id], onDelete: Restrict)

  @@unique([videoId, version])
  @@index([declaredByAccountId, declaredAt])
}

model Report {
  id                String       @id @default(uuid()) @db.Uuid
  reporterProfileId String       @db.Uuid
  moderationCaseId  String?      @db.Uuid
  channelId         String?      @db.Uuid
  videoId           String?      @db.Uuid
  commentId         String?      @db.Uuid
  reason            ReportReason
  details           String?      @db.Text
  status            ReportStatus @default(OPEN)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  resolvedAt        DateTime?

  reporterProfile ViewerProfile   @relation(fields: [reporterProfileId], references: [id], onDelete: Cascade)
  moderationCase  ModerationCase? @relation(fields: [moderationCaseId], references: [id], onDelete: SetNull)
  channel         Channel?        @relation(fields: [channelId], references: [id], onDelete: SetNull)
  video           Video?          @relation(fields: [videoId], references: [id], onDelete: SetNull)
  comment         Comment?        @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([moderationCaseId, createdAt])
  @@index([videoId, status])
  @@index([channelId, status])
  @@index([commentId, status])
}

model ModerationCase {
  id                  String               @id @default(uuid()) @db.Uuid
  assignedToAccountId String?              @db.Uuid
  status              ModerationCaseStatus @default(OPEN)
  summary             String?              @db.Text
  resolution          String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  closedAt            DateTime?

  assignedTo Account? @relation("ModerationAssignee", fields: [assignedToAccountId], references: [id], onDelete: SetNull)
  reports    Report[]

  @@index([status, createdAt])
  @@index([assignedToAccountId, status])
}

model PlatformSetting {
  id            String                   @id @default(uuid()) @db.Uuid
  namespace     PlatformSettingNamespace
  key           String                   @db.VarChar(120)
  valueType     PlatformSettingValueType
  value         Json                     @db.JsonB
  schemaVersion Int                      @default(1)
  description   String?                  @db.VarChar(500)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([namespace, key])
  @@index([namespace])
}

model FeatureFlag {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique @db.VarChar(120)
  description       String?  @db.VarChar(500)
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([enabled, key])
}

model AdminAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorAccountId String?  @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @db.VarChar(120)
  entityId       String?  @db.VarChar(120)
  reason         String?  @db.Text
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now())

  actor Account? @relation("AdminAuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([actorAccountId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model AdPlacement {
  id              String            @id @default(uuid()) @db.Uuid
  key             String            @unique @db.VarChar(120)
  name            String            @db.VarChar(160)
  inventoryFamily AdInventoryFamily
  format          AdPlacementFormat
  enabled         Boolean           @default(true)
  config          Json?             @db.JsonB
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  adEvents AdEvent[]

  @@index([inventoryFamily, enabled])
}

model Advertiser {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @db.VarChar(160)
  status    AdvertiserStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  campaigns Campaign[]

  @@index([status, createdAt])
}

model Campaign {
  id           String         @id @default(uuid()) @db.Uuid
  advertiserId String         @db.Uuid
  name         String         @db.VarChar(160)
  status       CampaignStatus @default(DRAFT)
  startsAt     DateTime?
  endsAt       DateTime?
  budget       Decimal?       @db.Decimal(20, 6)
  currency     String?        @db.Char(3)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  advertiser      Advertiser            @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  creatives       Creative[]
  adEvents        AdEvent[]
  earningsEntries EarningsLedgerEntry[]

  @@index([advertiserId, status])
  @@index([status, startsAt, endsAt])
}

model Creative {
  id             String         @id @default(uuid()) @db.Uuid
  campaignId     String         @db.Uuid
  mediaAssetId   String?        @db.Uuid
  name           String         @db.VarChar(160)
  type           CreativeType
  status         CreativeStatus @default(DRAFT)
  destinationUrl String?        @db.Text
  vastTagUrl     String?        @db.Text
  headline       String?        @db.VarChar(200)
  body           String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  adEvents   AdEvent[]

  @@index([campaignId, status])
  @@index([mediaAssetId])
}

model AdEvent {
  id          String      @id @default(uuid()) @db.Uuid
  placementId String      @db.Uuid
  campaignId  String?     @db.Uuid
  creativeId  String?     @db.Uuid
  videoId     String?     @db.Uuid
  profileId   String?     @db.Uuid
  eventType   AdEventType
  requestId   String?     @db.VarChar(120)
  sessionId   String?     @db.VarChar(120)
  revenue     Decimal?    @db.Decimal(20, 6)
  currency    String?     @db.Char(3)
  metadata    Json?       @db.JsonB
  occurredAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())

  placement AdPlacement    @relation(fields: [placementId], references: [id], onDelete: Restrict)
  campaign  Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creative  Creative?      @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  video     Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  profile   ViewerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([placementId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([creativeId, occurredAt])
  @@index([videoId, occurredAt])
  @@index([profileId, occurredAt])
  @@index([eventType, occurredAt])
}

model CreatorContract {
  id              String                @id @default(uuid()) @db.Uuid
  channelId       String                @db.Uuid
  status          CreatorContractStatus @default(PENDING)
  revenueShareBps Int?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  termsVersion    String?               @db.VarChar(80)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  channel       Channel                @relation(fields: [channelId], references: [id], onDelete: Restrict)
  ledgerEntries EarningsLedgerEntry[]

  @@index([channelId, status, effectiveFrom])
}

model EarningsLedgerEntry {
  id          String            @id @default(uuid()) @db.Uuid
  channelId   String            @db.Uuid
  contractId  String?           @db.Uuid
  campaignId  String?           @db.Uuid
  videoId     String?           @db.Uuid
  payoutId    String?           @db.Uuid
  type        EarningsEntryType
  amount      Decimal           @db.Decimal(20, 6)
  currency    String            @db.Char(3)
  memo        String?           @db.VarChar(500)
  occurredAt  DateTime          @default(now())
  finalizedAt DateTime?
  createdAt   DateTime          @default(now())

  channel  Channel          @relation(fields: [channelId], references: [id], onDelete: Restrict)
  contract CreatorContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  campaign Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  video    Video?           @relation(fields: [videoId], references: [id], onDelete: SetNull)
  payout   Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([channelId, occurredAt])
  @@index([contractId, occurredAt])
  @@index([payoutId])
  @@index([type, occurredAt])
}

model Payout {
  id                String       @id @default(uuid()) @db.Uuid
  channelId         String       @db.Uuid
  status            PayoutStatus @default(PENDING)
  amount            Decimal      @db.Decimal(20, 6)
  currency          String       @db.Char(3)
  externalReference String?      @db.VarChar(255)
  requestedAt       DateTime     @default(now())
  processedAt       DateTime?
  paidAt            DateTime?
  failureReason     String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  channel       Channel               @relation(fields: [channelId], references: [id], onDelete: Restrict)
  ledgerEntries EarningsLedgerEntry[]

  @@index([channelId, status, requestedAt])
  @@index([status, requestedAt])
}
