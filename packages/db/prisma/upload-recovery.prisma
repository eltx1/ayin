// Dormant persistence only. Production issuance must wait for worker integrity
// verification and atomic privacy multipart-cleanup obligations.
enum MediaUploadSessionAuthority {
  OWNER
  ADMIN
}

enum MediaUploadSessionMode {
  SINGLE
  MULTIPART
}

enum MediaUploadSessionState {
  PREPARING
  OPEN
  FINALIZING
  COMPLETED
  CANCELLING
  ABORTED
  EXPIRED
  REVOKED
  UNRESOLVED
}

model MediaUploadSession {
  id                       String                      @id @default(uuid()) @db.Uuid
  creationRequestId        String?                     @db.Uuid
  creationRequestDigest    String?                     @db.Char(64)
  // Explicit server reservation witness; null legacy history stays unknown.
  grantlessReservationId   String?                     @db.Uuid
  grantReservationCount    Int                         @default(0)
  // Historical sessions retain V1; only new finite-protocol reservations use V2.
  sourceProtocolVersion    Int                         @default(1)
  providerExposureBytes    BigInt?
  sourceAssetId            String?                     @unique @db.Uuid
  initiatingAccountId      String?                     @db.Uuid
  channelId                String                      @db.Uuid
  videoId                  String?                     @db.Uuid
  authority                MediaUploadSessionAuthority
  mode                     MediaUploadSessionMode
  objectKey                String                      @db.VarChar(1024)
  providerUploadId         String?                     @db.VarChar(1024)
  sizeBytes                BigInt
  mimeType                 String                      @db.VarChar(255)
  partSizeBytes            BigInt
  contentIdentityAlgorithm String                      @db.VarChar(32)
  contentIdentityDigest    String?                     @db.Char(64)
  state                    MediaUploadSessionState     @default(PREPARING)
  revision                 Int                         @default(1)
  createdAt                DateTime                    @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
  updatedAt                DateTime                    @updatedAt
  hardExpiresAt            DateTime
  // Future issuance must persist the maximum signed grant expiry atomically.
  // Null is unknown, never proof that no grant/in-flight write exists.
  lastGrantExpiresAt       DateTime?
  grantsRevokedAt          DateTime?
  cleanupRequestedAt       DateTime?
  cleanupRetainUntil       DateTime?

  operations        MediaUploadOperation[]
  sourceAsset       MediaAsset?            @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  initiatingAccount Account?               @relation(fields: [initiatingAccountId], references: [id], onDelete: SetNull)

  // Snapshot addresses survive reference removal for later, explicit cleanup.
  // SET NULL is loss of recoverability, never evidence of privacy completion.
  @@unique([initiatingAccountId, creationRequestId])
  @@index([initiatingAccountId, channelId, createdAt])
  @@index([state, hardExpiresAt])
  @@index([cleanupRetainUntil])
  @@index([channelId, state, hardExpiresAt])
}

// Bounded by the command service; no signed URLs or client-supplied provider IDs.
enum MediaUploadOperationStatus {
  RESERVED
  DISPATCHED
  SUCCEEDED
  UNKNOWN
}

enum MediaUploadProviderOutcome {
  NOT_DISPATCHED
  UNKNOWN
  ACKNOWLEDGED
}

model MediaUploadOperation {
  id                String                     @id @default(uuid()) @db.Uuid
  sessionId         String                     @db.Uuid
  requestId         String                     @db.Uuid
  kind              String                     @db.VarChar(16)
  requestDigest     String                     @db.Char(64)
  expectedRevision  Int
  status            MediaUploadOperationStatus @default(RESERVED)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  dispatchStartedAt DateTime?
  providerOutcome   MediaUploadProviderOutcome @default(NOT_DISPATCHED)
  providerTerminalAt DateTime?
  providerUploadId  String?                    @db.VarChar(1024)
  grantIssuedAt     DateTime?
  grantExpiresAt    DateTime?
  session           MediaUploadSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, requestId])
}
