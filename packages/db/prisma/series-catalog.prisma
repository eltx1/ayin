enum SeriesCatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SeriesEpisodeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SeriesArtworkType {
  POSTER
  BACKDROP
  LOGO
}

enum SeriesAvailabilityRule {
  ALLOW
  BLOCK
}

/// Editorial identity for a series. Playable media remains in existing Video rows.
model Series {
  id               String              @id @default(uuid()) @db.Uuid
  title            String              @db.VarChar(200)
  slug             String              @unique @db.VarChar(160)
  synopsis         String              @db.Text
  releaseYear      Int?
  maturityRating   String              @db.VarChar(32)
  originalLanguage String              @db.VarChar(16)
  status           SeriesCatalogStatus @default(DRAFT)
  trailerVideoId   String?             @db.Uuid
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  genres        SeriesGenreAssignment[]
  artwork       SeriesArtwork[]
  availability  SeriesAvailability[]
  seasons       SeriesSeason[]
  localizations SeriesLocalization[]

  @@index([status, publishedAt])
  @@index([releaseYear, status])
  @@index([trailerVideoId])
}

model SeriesGenre {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(80)
  name      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series SeriesGenreAssignment[]
}

model SeriesGenreAssignment {
  seriesId  String   @db.Uuid
  genreId   String   @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now())

  series Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre  SeriesGenre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([seriesId, genreId])
  @@unique([seriesId, position])
  @@index([genreId, seriesId])
}

/// References an existing MediaAsset row. No media bytes are copied into the series catalog.
model SeriesArtwork {
  id           String            @id @default(uuid()) @db.Uuid
  seriesId     String            @db.Uuid
  mediaAssetId String            @db.Uuid
  type         SeriesArtworkType
  altText      String?           @db.VarChar(240)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, type])
  @@index([mediaAssetId])
}

/// Locale-specific copy for a Series identity. Artwork override IDs reference existing MediaAsset rows.
model SeriesLocalization {
  id                   String   @id @default(uuid()) @db.Uuid
  seriesId             String   @db.Uuid
  locale               String   @db.VarChar(35)
  title                String?  @db.VarChar(200)
  synopsis             String?  @db.Text
  shortDescription     String?  @db.VarChar(500)
  posterMediaAssetId   String?  @db.Uuid
  backdropMediaAssetId String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, locale])
  @@index([locale, seriesId])
  @@index([posterMediaAssetId])
  @@index([backdropMediaAssetId])
}

/// Optional time- and territory-scoped availability for the complete series catalog identity.
/// No rows means the legacy/global behavior remains unchanged; explicit rows narrow availability.
model SeriesAvailability {
  id            String                 @id @default(uuid()) @db.Uuid
  seriesId      String                 @db.Uuid
  territoryCode String                 @db.VarChar(2)
  rule          SeriesAvailabilityRule @default(ALLOW)
  startsAt      DateTime?
  endsAt        DateTime?
  note          String?                @db.VarChar(240)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId, territoryCode, rule, startsAt, endsAt])
}

model SeriesSeason {
  id           String   @id @default(uuid()) @db.Uuid
  seriesId     String   @db.Uuid
  seasonNumber Int
  title        String?  @db.VarChar(200)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  series        Series                     @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  artwork       SeriesSeasonArtwork[]
  episodes      SeriesEpisode[]
  localizations SeriesSeasonLocalization[]

  @@unique([seriesId, seasonNumber])
  @@unique([seriesId, sortOrder])
  @@index([seriesId, sortOrder, seasonNumber, id])
}

model SeriesSeasonLocalization {
  id               String   @id @default(uuid()) @db.Uuid
  seasonId         String   @db.Uuid
  locale           String   @db.VarChar(35)
  title            String?  @db.VarChar(200)
  shortDescription String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  season SeriesSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, locale])
  @@index([locale, seasonId])
}

/// Optional season-specific artwork referencing existing MediaAsset rows.
model SeriesSeasonArtwork {
  id           String            @id @default(uuid()) @db.Uuid
  seasonId     String            @db.Uuid
  mediaAssetId String            @db.Uuid
  type         SeriesArtworkType
  altText      String?           @db.VarChar(240)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  season SeriesSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, type])
  @@index([mediaAssetId])
}

/// Catalog episode identity. videoId deliberately links to an existing playable Video row.
model SeriesEpisode {
  id            String              @id @default(uuid()) @db.Uuid
  seasonId      String              @db.Uuid
  episodeNumber Int
  title         String              @db.VarChar(200)
  synopsis      String              @db.Text
  sortOrder     Int                 @default(0)
  releaseDate   DateTime?
  status        SeriesEpisodeStatus @default(DRAFT)
  videoId       String?             @db.Uuid
  publishedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  season        SeriesSeason                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  localizations SeriesEpisodeLocalization[]

  @@unique([seasonId, episodeNumber])
  @@unique([seasonId, sortOrder])
  @@index([seasonId, status, sortOrder, episodeNumber, id])
  @@index([videoId])
  @@index([status, publishedAt])
}

model SeriesEpisodeLocalization {
  id               String   @id @default(uuid()) @db.Uuid
  episodeId        String   @db.Uuid
  locale           String   @db.VarChar(35)
  title            String?  @db.VarChar(200)
  synopsis         String?  @db.Text
  shortDescription String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  episode SeriesEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, locale])
  @@index([locale, episodeId])
}
