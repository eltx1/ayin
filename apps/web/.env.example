NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.ayin.stream
# Same private value as the API; server-only and never NEXT_PUBLIC.
AYIN_INTERNAL_EDGE_TOKEN=
# Optional build-time CSP connection inventory; leaves the enforced policy active.
# Read docs/SECURITY_CSP.md before promoting the candidate to enforcement.
AYIN_CSP_REPORT_ONLY=false
# Exact operator-approved HTTPS upload origin, no path/query/credentials/wildcards.
# Keep blank until a real R2 test upload establishes the bucket's signing origin.
AYIN_CSP_UPLOAD_ORIGIN=
