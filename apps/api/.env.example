APP_ENV=local
API_HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ayin:ayin@127.0.0.1:5432/ayin?schema=public
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
# Exactly 32 random bytes encoded as base64. Required at API startup; generate a unique secret per environment.
PAYOUT_DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
