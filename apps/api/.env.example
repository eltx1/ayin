APP_ENV=local
API_HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ayin:ayin@127.0.0.1:5432/ayin?schema=public
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

# Password-recovery email delivery. Production uses Gmail-compatible STARTTLS SMTP.
MAIL_SCHEME=starttls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=ayin.stream
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AYIN
MAIL_TIMEOUT_MS=15000

# Exactly 32 random bytes encoded as base64. Required at API startup; generate a unique secret per environment.
PAYOUT_DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
