APP_ENV=local
API_HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ayin:ayin@127.0.0.1:5432/ayin?schema=public
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

# Trusted region enforcement. Enable Cloudflare country headers only when the API origin is protected behind Cloudflare.
AYIN_TRUST_CLOUDFLARE_REGION=false
AYIN_INTERNAL_EDGE_TOKEN=

# Provider-neutral observability. Production deployment sets AYIN_RELEASE_SHA automatically.
LOG_LEVEL=info
AYIN_RELEASE_SHA=
MEDIA_WORKER_HEARTBEAT_PATH=/tmp/ayin-media-worker-heartbeat.json
# 1-365 days from cleanup registration; only verified DONE addresses are aged out.
MEDIA_UPLOAD_CLEANUP_RETENTION_DAYS=30

# Password-recovery email delivery. Production uses Gmail-compatible STARTTLS SMTP.
MAIL_SCHEME=starttls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=ayin.stream
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AYIN
MAIL_TIMEOUT_MS=15000

# Exactly 32 random bytes encoded as base64. Required at API startup; generate a unique secret per environment.
PAYOUT_DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64

# Finite multipart recovery remains off pending isolated R2 and browser acceptance.
AYIN_UPLOAD_RECOVERY_V2_ENABLED=0
# One explicitly reviewed account/channel canary only; no actual IDs are supplied.
# AYIN_UPLOAD_RECOVERY_CANARY_ACCOUNT_ID=<uuid>
# AYIN_UPLOAD_RECOVERY_CANARY_CHANNEL_ID=<uuid>
AYIN_UPLOAD_RECOVERY_CANARY_SOURCE_MAX_BYTES=0
AYIN_UPLOAD_RECOVERY_OUTPUT_ENVELOPE_BYTES=0
# Zero budgets keep V2 admission closed even if the switch is enabled. Set only after review.
# Admission-accounting ceilings, not provider-enforced physical-byte bounds.
# All grants for one source reserve expected part slots × 5 GiB until observed cleanup.
AYIN_UPLOAD_RECOVERY_DEBT_ACCOUNT_BYTES=0
AYIN_UPLOAD_RECOVERY_DEBT_CHANNEL_BYTES=0
